Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Automatic-Module-Name: com.tlcsdm.eclipse.ucdetector
Bundle-Name: %pluginName
Bundle-SymbolicName: com.tlcsdm.eclipse.ucdetector;singleton:=true
Bundle-Version: 2.1.1.qualifier
Bundle-Activator: com.tlcsdm.eclipse.ucdetector.UCDetectorPlugin
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.core.filebuffers,
 org.eclipse.jdt.core,
 org.eclipse.jdt.ui,
 org.eclipse.search,
 org.eclipse.jface.text,
 org.eclipse.ui.ide,
 org.eclipse.ui.editors,
 org.eclipse.ui.console,
 org.eclipse.pde.core;resolution:=optional,
 org.eclipse.jdt.core.manipulation
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Export-Package: com.tlcsdm.eclipse.ucdetector,
 com.tlcsdm.eclipse.ucdetector.action,
 com.tlcsdm.eclipse.ucdetector.cycle,
 com.tlcsdm.eclipse.ucdetector.cycle.model,
 com.tlcsdm.eclipse.ucdetector.headless,
 com.tlcsdm.eclipse.ucdetector.iterator,
 com.tlcsdm.eclipse.ucdetector.preferences,
 com.tlcsdm.eclipse.ucdetector.preferences.modes,
 com.tlcsdm.eclipse.ucdetector.quickfix,
 com.tlcsdm.eclipse.ucdetector.report,
 com.tlcsdm.eclipse.ucdetector.search,
 com.tlcsdm.eclipse.ucdetector.util
